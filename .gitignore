```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Temporary files
*.tmp
*.temp
*~

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Testing
.nyc_output/
.mypy_cache/
.pytest_cache/

# Distribution / packaging
.Python
env/
venv/
.venv/
.ENV
bin/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled JavaScript
lib-cov
*.min.js

# TypeScript
*.tsbuildinfo
```