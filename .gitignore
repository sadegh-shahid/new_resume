```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
*.tmp

# Coverage reports
coverage/
htmlcov/

# Python specific (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Distribution / packaging
.Python
*.egg-info/
.eggs/
.installed.cfg
*.egg

# OS generated files
.DS_Store
Thumbs.db

# Testing
.nyc_output/
coverage.xml
*.lcov

# Local configuration
.env.local
.env.development.local
.env.test.local
.env.production.local
```